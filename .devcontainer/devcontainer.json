{
    "name": "Hugo (Community)",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            // Node.js 版本
            "NODE_VERSION": "22",
            // Hugo 版本：必须是仍提供 extended 构建的版本
            // （Hugo v0.170.0 起官方已移除 extended 构建，不能再无脑用 latest）
            "HUGO_VERSION": "0.154.2",
            // Dart Sass 版本，Stack 主题编译 SCSS 需要
            "DART_SASS_VERSION": "1.97.1"
        }
    },
    // 配置 VS Code / Codespaces 的编辑器行为与插件
    "customizations": {
        "vscode": {
            "settings": {
                "html.format.templating": true
            },
            "extensions": [
                "tamasfe.even-better-toml",
                "davidanson.vscode-markdownlint"
            ]
        }
    },
    // 把 Hugo 开发服务器的端口转发到本机
    "forwardPorts": [
        1313
    ],
    // Hugo modules 需要 Go 才能拉取 Stack 主题；
    // 这里只保留官方维护的 go feature，
    // 原来的 ghcr.io/prplecake/devcontainer-features/dart-sass:1 仓库已不存在，
    // 会导致 feature 拉取失败 -> 容器配置错误 -> recovery mode，因此已删除（Dart Sass 改为在 Dockerfile 里安装）。
    "features": {
        "ghcr.io/devcontainers/features/go:1": {}
    },
    "remoteUser": "node"
}
